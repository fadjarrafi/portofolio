---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  twitterImage?: string;
  publishedAt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  lang?: 'en' | 'id';
  translationUrl?: string;
  translationLang?: 'en' | 'id';
}

const {
  title,
  description = 'This is my portfolio.',
  ogImage,
  twitterImage,
  publishedAt,
  type = 'website',
  noindex = false,
  lang = 'en',
  translationUrl,
  translationLang,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fadjarrafi.my.id';
const pageTitle = title ? `${title} | fadjarrafi` : 'fadjarrafi | fullstack dev';
const resolvedOg = ogImage ?? `${siteUrl}/og-image.png`;
const resolvedTwitter = twitterImage ?? ogImage ?? `${siteUrl}/twitter-card.png`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const resolvedTranslationUrl = translationUrl ? new URL(translationUrl, siteUrl).toString() : undefined;
---

<!doctype html>
<html
  lang={lang}
  style="--font-space-grotesk: 'Space Grotesk', sans-serif; --font-ibm-plex-mono: 'IBM Plex Mono', monospace;"
  class="dark"
>
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
      // window.__firstVisit drives the astro:page-load handler below (plain
      // JS state, untouched by Astro's swap) since that handler can't read
      // sessionStorage itself to make this call — by the time it runs even
      // on this very first load, the line below has already written '1'.
      // The .no-preloader class is a separate, narrower job: it only needs
      // to prevent a flash on a repeat *hard* reload, where this script runs
      // again before first paint — the html.no-preloader:has-been-stripped-
      // by-a-soft-nav case doesn't matter, since #preloader itself is gone
      // from the DOM by then anyway (see the astro:page-load handler).
      const seen = sessionStorage.getItem('visited');
      window.__firstVisit = !seen;
      if (seen) document.documentElement.classList.add('no-preloader');
      sessionStorage.setItem('visited', '1');

      // Theme: dark is the default look (<html> already carries the .dark
      // class in the static markup above, so no-JS visitors get dark too).
      // localStorage 'theme' is only ever written once the visitor
      // explicitly overrides it via the toggle; absent, stay dark. Applying
      // it here (before first paint) only matters for the 'light' override
      // case; re-applied in the astro:after-swap handler below since
      // ClientRouter resets <html>'s class attribute to match each
      // newly-fetched page's static (always dark) markup on every soft nav.
      window.__applyTheme = () => {
        const isDark = localStorage.getItem('theme') !== 'light';
        document.documentElement.classList.toggle('dark', isDark);
      };
      window.__applyTheme();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {resolvedTranslationUrl && translationLang && (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang={translationLang} href={resolvedTranslationUrl} />
        <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOg} />
    <meta property="og:image:width" content="1081" />
    <meta property="og:image:height" content="411" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedTwitter} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics -->
    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
        <script define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <ClientRouter />
  </head>
  <body class="antialiased max-w-4xl mx-4 mt-8 lg:mx-auto text-ink bg-paper dark:text-mist dark:bg-surface-dark">
    <div id="preloader" aria-hidden="true">
      <div class="preloader-content">
        <img src="/favicon.svg" alt="" width="48" height="48" class="preloader-logo" />
        <div class="preloader-bar"></div>
      </div>
    </div>
    <div id="route-progress" aria-hidden="true"></div>
    <main class="flex-auto min-w-0 mt-6 flex flex-col px-2 md:px-0">
      <slot />
    </main>
    <Footer />
    <Lightbox />
  </body>
</html>

<script>
  // Re-runs on the initial load AND after every View Transitions navigation
  // (astro:page-load fires both times), since the swapped-in page has fresh
  // .scroll-animate / <img> elements that need their own observers.
  document.addEventListener('astro:page-load', () => {
    // Restore the .js class: Astro's ClientRouter resets <html>'s class
    // attribute to match each newly-fetched page's markup on every soft
    // navigation, which would otherwise silently disable the html.js-gated
    // .scroll-animate fade-in (see global.css) after the first page.
    document.documentElement.classList.add('js');

    // First-visit preloader: only ever shown when window.__firstVisit is
    // true, i.e. this tab's session had no prior page load. Hidden
    // immediately (no fade) on every later page, since it was never shown
    // there in the first place.
    const preloader = document.getElementById('preloader');
    if (preloader) {
      if (!(window as any).__firstVisit) {
        preloader.remove();
      } else {
        (window as any).__firstVisit = false;
        const minDelay = new Promise((r) => setTimeout(r, 500));
        const ready =
          document.readyState === 'complete'
            ? Promise.resolve()
            : new Promise((r) => window.addEventListener('load', r, { once: true }));
        Promise.all([minDelay, ready]).then(() => {
          preloader.classList.add('hidden');
          setTimeout(() => preloader.remove(), 500);
        });
      }
    }

    // Scroll animate: observe .scroll-animate elements and add .visible class
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = el.dataset.delay ? parseInt(el.dataset.delay) : 0;
            setTimeout(() => el.classList.add('visible'), delay);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0, rootMargin: '0px 0px -50px 0px' }
    );
    document.querySelectorAll('.scroll-animate').forEach((el) => observer.observe(el));

    // Image loading skeleton: tag any not-yet-painted <img> with a shimmer
    // background (see img[data-skeleton] in global.css) and drop it on
    // load/error. Images already complete (cached, or fast enough to beat
    // this script) skip straight to clearing — some images (e.g. the hero
    // avatar) render with data-skeleton already in the static markup so the
    // shimmer is visible from first paint instead of racing this script.
    document.querySelectorAll('img').forEach((img) => {
      if (img.complete) {
        img.removeAttribute('data-skeleton');
        return;
      }
      img.setAttribute('data-skeleton', '');
      const clear = () => img.removeAttribute('data-skeleton');
      img.addEventListener('load', clear, { once: true });
      img.addEventListener('error', clear, { once: true });
    });
  });

  // Route-navigation progress bar. This script tag is identical on every
  // page, so Astro/Vite bundles and executes it only once for the whole
  // session — meaning #route-progress must be looked up fresh inside each
  // handler below rather than cached, since the swap replaces that node on
  // every navigation. astro:before-preparation fires as soon as a same-origin
  // navigation starts (before the next page's HTML arrives), astro:page-load
  // once it has been swapped in and its scripts ran.
  document.addEventListener('astro:before-preparation', () => {
    const progress = document.getElementById('route-progress');
    if (!progress) return;
    progress.classList.remove('done');
    progress.style.transform = 'scaleX(0)';
    // next frame so the transform transition actually animates from 0
    requestAnimationFrame(() => {
      progress.classList.add('loading');
      progress.style.transform = 'scaleX(0.7)';
    });
  });
  document.addEventListener('astro:page-load', () => {
    const progress = document.getElementById('route-progress');
    if (!progress) return;
    progress.classList.add('done');
    progress.style.transform = '';
    setTimeout(() => progress.classList.remove('loading', 'done'), 400);
  });

  // Reset problem as .js above, for the theme override — fired on
  // astro:after-swap (synchronous, right after the DOM swap, before the next
  // paint) rather than astro:page-load (fires after the new page finishes
  // loading, which paints the wrong theme first and flashes to the correct
  // one).
  document.addEventListener('astro:after-swap', () => {
    (window as any).__applyTheme();
  });

  // Delegated on document (survives soft navigations) rather than bound to
  // the button directly, since Nav — and its button — gets replaced on swap.
  document.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest('#theme-toggle');
    if (!button) return;
    const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    document.documentElement.classList.toggle('dark', next === 'dark');
  });
</script>
