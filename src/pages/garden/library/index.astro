---
import { readFileSync } from 'fs';
import { resolve } from 'path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import GardenNav from '../../../components/GardenNav.astro';

let library: any[] = [];
try {
  const data = readFileSync(resolve('public/data/library.json'), 'utf-8');
  library = JSON.parse(data);
} catch {}
---

<BaseLayout title="Library" description="Reading notes and resources.">
  <Nav />
  <section class="min-h-screen pb-16">
    <div class="max-w-5xl mx-auto">
      <div class="scroll-animate">
        <h1 class="font-semibold text-2xl mb-1 tracking-tighter">Library</h1>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-8">Reading notes and resources.</p>
      </div>
      <div class="scroll-animate" data-delay="50">
        <GardenNav />
      </div>
      {library.length === 0 ? (
        <div class="scroll-animate" data-delay="100">
          <p class="text-sm text-neutral-500">No library entries yet.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5 scroll-animate" data-delay="100">
          {library.map((item: any) => {
            const coverSrc = item.cover
              ? item.cover
              : item.isbn
              ? `https://covers.openlibrary.org/b/isbn/${item.isbn}-L.jpg?default=false`
              : null;
            const goodreadsUrl = item.goodreads ?? null;
            return (
            <div class="group flex flex-col border border-neutral-200 dark:border-neutral-800 rounded-lg overflow-hidden hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors">
              <div class="relative aspect-[2/3] bg-gradient-to-br from-neutral-100 to-neutral-200 dark:from-neutral-800 dark:to-neutral-900">
                <div class="absolute inset-0 flex flex-col justify-center items-center text-center p-4">
                  <span class="text-sm font-semibold text-neutral-500 dark:text-neutral-400 tracking-tight line-clamp-4">{item.title}</span>
                  <span class="text-xs text-neutral-400 dark:text-neutral-500 mt-1.5 line-clamp-2">{item.author}</span>
                </div>
                {coverSrc && (
                  <img
                    src={coverSrc}
                    alt={`Cover of ${item.title}`}
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover"
                    onerror="this.remove()"
                  />
                )}
                <span class={`absolute top-2 right-2 text-xs px-2 py-0.5 rounded-full font-medium backdrop-blur ${
                  item.status === 'completed'
                    ? 'bg-green-100/90 dark:bg-green-900/60 text-green-700 dark:text-green-300'
                    : 'bg-yellow-100/90 dark:bg-yellow-900/60 text-yellow-700 dark:text-yellow-300'
                }`}>
                  {item.status === 'completed' ? 'Completed' : 'Reading'}
                </span>
              </div>
              <div class="flex flex-col flex-1 p-4">
                <div class="flex items-start justify-between gap-2">
                  {item.url ? (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-semibold text-base tracking-tight hover:underline underline-offset-2 line-clamp-2"
                    >
                      {item.title}
                    </a>
                  ) : (
                    <h2 class="font-semibold text-base tracking-tight line-clamp-2">{item.title}</h2>
                  )}
                  <span class="shrink-0 text-xs px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
                    {item.type}
                  </span>
                </div>
                <p class="text-sm text-neutral-500 dark:text-neutral-500 mt-0.5">{item.author} · {item.year}</p>
                {item.rating && (
                  <div class="flex gap-0.5 mt-2">
                    {Array.from({ length: 5 }, (_, i) => (
                      <span class={i < item.rating ? 'text-yellow-400' : 'text-neutral-300 dark:text-neutral-700'}>★</span>
                    ))}
                  </div>
                )}
                {item.summary && (
                  <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2 line-clamp-3">{item.summary}</p>
                )}
                <div class="mt-auto pt-3">
                  {item.topics?.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {item.topics.map((t: string) => (
                        <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
                          {t}
                        </span>
                      ))}
                    </div>
                  )}
                  {goodreadsUrl && (
                    <a
                      href={goodreadsUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 mt-3 text-xs font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors"
                    >
                      Goodreads
                      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
