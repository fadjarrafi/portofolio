---
const navItems = [
  { path: '/', name: 'home' },
  { path: '/case-studies', name: 'case' },
  { path: '/writing', name: 'writing' },
  { path: '/garden/thoughts', name: 'garden' },
];

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  const base = `/${path.split('/').filter(Boolean)[0]}`;
  return currentPath === base || currentPath.startsWith(`${base}/`);
};
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-3 focus:py-2 focus:rounded-md focus:bg-neutral-900 focus:text-white dark:focus:bg-neutral-100 dark:focus:text-neutral-900"
>
  Skip to content
</a>

<aside class="-ml-[8px] mb-16 tracking-tight">
  <div class="lg:sticky lg:top-20">
    <nav
      class="flex flex-row items-start relative px-0 pb-0 fade md:overflow-auto scroll-pr-6 md:relative"
      id="nav"
    >
      <div class="flex flex-row space-x-0 pr-10">
        {navItems.map(({ path, name }) => {
          const active = isActive(path);
          return (
            <a
              href={path}
              aria-current={active ? 'page' : undefined}
              class={`flex align-middle relative py-1 px-2 m-1 border-b-2 transition-colors ${
                active
                  ? 'text-neutral-900 dark:text-neutral-100 font-medium border-signal-muted dark:border-signal'
                  : 'text-neutral-500 dark:text-neutral-400 border-transparent hover:text-neutral-800 dark:hover:text-neutral-200'
              }`}
            >
              {name}
            </a>
          );
        })}
      </div>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="flex items-center justify-center h-8 w-8 rounded-md m-1 ml-auto shrink-0 text-neutral-500 dark:text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 dark:hidden">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-4 w-4 dark:block">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
      </button>
    </nav>
  </div>
</aside>

<div id="main-content"></div>
