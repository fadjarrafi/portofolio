---
import { readFileSync } from 'fs';
import { resolve } from 'path';
import { parseFlow } from '../utils/flow';

interface ExperienceLink {
  label: string;
  url: string;
}

interface Experience {
  role: string;
  company: string;
  period: string;
  location: string;
  flow?: string;
  description: string;
  technologies: string[];
  links?: ExperienceLink[];
}

let experiences: Experience[] = [];
try {
  const data = readFileSync(resolve('public/data/experiences.json'), 'utf-8');
  experiences = JSON.parse(data);
} catch {}
---

<section>
  <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-6">Experience</h2>
  <div class="space-y-10">
    {experiences.map((exp) => (
      <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-x-6 gap-y-2">
        <p class="text-xs text-neutral-400 dark:text-neutral-500 tabular-nums sm:pt-0.5">{exp.period}</p>

        <div>
          <h3 class="text-base font-medium mb-2">{exp.role}, {exp.company}</h3>

          {exp.flow && (
            <div class="inline-block mb-3 px-3 py-1.5 rounded-md bg-ink border border-transparent dark:border-white/10 font-mono text-xs leading-relaxed text-paper dark:text-mist">
              {parseFlow(exp.flow).map((segment) => (
                <span
                  class={
                    segment.type === 'pipe'
                      ? 'text-signal'
                      : segment.type === 'sync'
                        ? 'text-copper'
                        : ''
                  }
                >
                  {segment.text}
                </span>
              ))}
            </div>
          )}

          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">{exp.description}</p>

          {exp.links && exp.links.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
              {exp.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-neutral-500 dark:text-neutral-400 underline underline-offset-2 decoration-neutral-300 dark:decoration-neutral-600 hover:text-neutral-800 dark:hover:text-neutral-200 transition-colors"
                >
                  {link.label}
                </a>
              ))}
            </div>
          )}

          {exp.technologies && exp.technologies.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {exp.technologies.map((tech) => (
                <span class="text-xs text-neutral-500 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-800 rounded-full px-2 py-0.5">
                  {tech}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
