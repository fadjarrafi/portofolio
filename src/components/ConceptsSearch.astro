---
interface Concept {
  term: string;
  domain: string[];
  brief: string;
  slug: string;
  extended?: string;
  examples?: string[];
  related?: string[];
  resources?: string[];
}

interface Props {
  concepts: Concept[];
  allDomains: string[];
}

const { concepts, allDomains } = Astro.props;
---

<div id="concepts-root">
  <div class="flex flex-wrap items-center gap-3 mb-6">
    <input
      type="text"
      id="cs-search"
      placeholder="Search concepts..."
      aria-label="Search concepts"
      class="flex-1 min-w-[140px] px-3 py-1.5 text-sm bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-neutral-600"
    />
    <div class="relative">
      <select
        id="cs-domain"
        aria-label="Filter by domain"
        class="appearance-none cursor-pointer text-xs pl-3 pr-8 py-2 bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-neutral-600"
      >
        <option value="all">All domains</option>
        {allDomains.map((d) => (
          <option value={d}>{d}</option>
        ))}
      </select>
      <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
    <button id="cs-clear" class="hidden text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Clear</button>
  </div>

  <p id="cs-count" class="hidden text-xs text-neutral-500 mb-4" aria-live="polite"></p>

  <div id="cs-list" class="divide-y divide-neutral-200 dark:divide-neutral-800 border border-neutral-200 dark:border-neutral-800 rounded-lg overflow-hidden">
    {concepts.map((c) => {
      const searchText = `${c.term} ${c.brief} ${c.extended ?? ''}`.toLowerCase();
      const domains = c.domain ?? [];
      return (
        <details class="concept-item group" id={`concept-${c.slug}`} data-search={searchText} data-domains={domains.join(',')}>
          <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none hover:bg-neutral-50 dark:hover:bg-neutral-900/60 transition-colors">
            <div class="flex flex-col gap-0.5 min-w-0 flex-1">
              <span class="font-medium text-sm text-neutral-900 dark:text-neutral-100">{c.term}</span>
              <span class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-1">{c.brief}</span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <div class="flex flex-wrap justify-end gap-1">
                {domains.map((d) => (
                  <span
                    class="domain-badge cursor-pointer text-xs px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-[#6b7a00] dark:text-[#BDDB0B] hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors"
                    data-domain={d}
                  >
                    {d}
                  </span>
                ))}
              </div>
              <svg class="w-4 h-4 text-neutral-400 transition-transform duration-200 group-open:rotate-180 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="px-5 pb-5 pt-1 border-t border-neutral-100 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/30">
            {c.extended && <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-4">{c.extended}</p>}
            {c.examples && c.examples.length > 0 && (
              <div class="mb-4">
                <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-2">Examples</p>
                <ul class="space-y-1">
                  {c.examples.map((ex) => (
                    <li class="text-sm text-neutral-600 dark:text-neutral-400 flex gap-2 before:content-['–'] before:text-neutral-300 dark:before:text-neutral-600 before:shrink-0">{ex}</li>
                  ))}
                </ul>
              </div>
            )}
            {c.related && c.related.length > 0 && (
              <div class="flex items-center flex-wrap gap-1.5">
                <span class="text-xs text-neutral-400">Related:</span>
                <span class="flex flex-wrap gap-1">
                  {c.related.map((r) => (
                    <button
                      type="button"
                      class="related-badge text-xs px-2 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-700 text-[#6b7a00] dark:text-[#BDDB0B] hover:border-neutral-400 dark:hover:border-neutral-500 transition-colors"
                      data-target={r}
                    >
                      {r}
                    </button>
                  ))}
                </span>
              </div>
            )}
          </div>
        </details>
      );
    })}
  </div>

  <div id="cs-empty" class="hidden py-16 text-center">
    <p class="text-sm text-neutral-500 mb-2">No concepts found</p>
    <button id="cs-clear2" class="text-sm text-neutral-900 dark:text-neutral-100 hover:underline">Clear filters</button>
  </div>
</div>

<script>
  const searchEl = document.getElementById('cs-search') as HTMLInputElement;
  const domainEl = document.getElementById('cs-domain') as HTMLSelectElement;
  const clearEl = document.getElementById('cs-clear') as HTMLButtonElement;
  const clearEl2 = document.getElementById('cs-clear2') as HTMLButtonElement;
  const list = document.getElementById('cs-list') as HTMLElement;
  const emptyEl = document.getElementById('cs-empty') as HTMLElement;
  const countEl = document.getElementById('cs-count') as HTMLElement;
  const items = Array.from(list.querySelectorAll<HTMLDetailsElement>('.concept-item'));
  const total = items.length;

  function render() {
    const q = searchEl.value.trim().toLowerCase();
    const domain = domainEl.value;
    const active = q !== '' || domain !== 'all';

    let visibleCount = 0;
    items.forEach((item) => {
      const matchesSearch = !q || (item.dataset.search ?? '').includes(q);
      const domains = item.dataset.domains ? item.dataset.domains.split(',') : [];
      const matchesDomain = domain === 'all' || domains.includes(domain);
      const visible = matchesSearch && matchesDomain;

      item.classList.toggle('hidden', !visible);
      if (visible) {
        visibleCount++;
        if (q) item.open = true;
      }
    });

    clearEl.classList.toggle('hidden', !active);
    countEl.classList.toggle('hidden', !active);
    if (active) countEl.textContent = `${visibleCount} of ${total} concepts`;
    emptyEl.classList.toggle('hidden', visibleCount > 0);
    list.classList.toggle('hidden', visibleCount === 0);
  }

  function clearFilters() {
    searchEl.value = '';
    domainEl.value = 'all';
    render();
  }

  searchEl.addEventListener('input', render);
  domainEl.addEventListener('change', render);
  clearEl.addEventListener('click', clearFilters);
  clearEl2.addEventListener('click', clearFilters);

  // Mouse shortcut for filtering by domain; the <select> above remains the
  // fully keyboard/AT-accessible control for this same filter.
  list.addEventListener('click', (e) => {
    const badge = (e.target as HTMLElement).closest<HTMLElement>('.domain-badge');
    if (!badge || !badge.dataset.domain) return;
    e.preventDefault();
    e.stopPropagation();
    domainEl.value = badge.dataset.domain;
    render();
  });

  // Jump to a related concept by slug.
  list.addEventListener('click', (e) => {
    const relBtn = (e.target as HTMLElement).closest<HTMLElement>('.related-badge');
    if (!relBtn || !relBtn.dataset.target) return;
    e.preventDefault();
    const target = document.getElementById(`concept-${relBtn.dataset.target}`);
    if (!target || !(target instanceof HTMLDetailsElement)) return;
    clearFilters();
    target.open = true;
    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  render();
</script>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
