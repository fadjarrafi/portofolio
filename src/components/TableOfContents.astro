---
interface Heading {
  text: string;
  slug: string;
}
interface Props {
  headings: Heading[];
  id?: string;
}
const { headings, id = 'toc' } = Astro.props;
if (headings.length === 0) return;
---

<div class="p-4 border border-neutral-200 dark:border-neutral-800 rounded-lg bg-neutral-50 dark:bg-neutral-900" id={id}>
  <h2 class="font-semibold mb-3 text-neutral-900 dark:text-neutral-100 text-sm">
    Table of Contents
  </h2>
  <nav>
    <ul class="space-y-2 font-mono">
      {headings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            data-toc-link={heading.slug}
            class="text-sm block transition-all duration-200 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 pl-3"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  // Always resolves against the live DOM rather than a captured NodeList, so
  // it stays correct even when called from a click handler bound long before
  // the current page's TOC existed.
  function setActiveTocLink(id: string) {
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((link) => {
      const isActive = link.dataset.tocLink === id;
      link.className = `text-sm block transition-all duration-200 pl-3 ${
        isActive
          ? 'text-neutral-900 dark:text-neutral-100 font-medium border-l-2 border-neutral-900 dark:border-neutral-100 -ml-[2px]'
          : 'text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100'
      }`;
    });
  }

  // Re-scan headings/links on every navigation (astro:page-load fires on the
  // initial load too), since View Transitions swaps in a fresh TOC + article.
  document.addEventListener('astro:page-load', () => {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (links.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActiveTocLink(entry.target.id);
        });
      },
      { rootMargin: '-100px 0px -66% 0px', threshold: 0 }
    );

    links.forEach((link) => {
      const el = document.getElementById(link.dataset.tocLink!);
      if (el) observer.observe(el);
    });
  });

  // Bound once on `document` (which persists across View Transitions
  // navigations) rather than re-added on every astro:page-load.
  //
  // No preventDefault/scrollTo here — Astro's ClientRouter already
  // special-cases same-page hash links (moveToLocation() in
  // astro/dist/transitions/router.js) and performs the native fragment
  // scroll itself, respecting the .prose heading scroll-margin-top and
  // html's scroll-behavior: smooth in global.css. This just flips the
  // active link instantly rather than waiting on the scroll-driven
  // IntersectionObserver above to catch up.
  if (!(window as any).__tocClickBound) {
    (window as any).__tocClickBound = true;

    document.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!anchor) return;
      const id = anchor.getAttribute('href')!.substring(1);
      if (!document.querySelector(`[data-toc-link="${id}"]`)) return;
      setActiveTocLink(id);
    });
  }
</script>
