---
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/format';

const allPosts = await getCollection('blog', ({ id, data }) => {
  return id.startsWith('en/') && data.featured === true;
});

const featuredPosts = allPosts.sort((a, b) =>
  new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
---

<div>
  <div class="scroll-animate" data-delay="0">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Writing</h2>
      <a
        href="/writing"
        class="text-xs text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        View all →
      </a>
    </div>
  </div>
  <div class="divide-y divide-neutral-100 dark:divide-neutral-900">
    {featuredPosts.map((post, index) => {
      const slug = post.id.replace('en/', '').replace(/\.mdx?$/, '');
      return (
        <a
          class="scroll-animate group flex items-baseline justify-between gap-4 py-3"
          data-delay={100 * (index + 1)}
          href={`/writing/en/${slug}`}
        >
          <div class="min-w-0">
            <p class="text-sm font-medium truncate group-hover:underline">{post.data.title}</p>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 truncate">{post.data.summary}</p>
          </div>
          <p class="text-xs text-neutral-400 dark:text-neutral-500 tabular-nums shrink-0">
            {formatDate(post.data.publishedAt, false)}
          </p>
        </a>
      );
    })}
  </div>
</div>
