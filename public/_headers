# Cloudflare Pages response headers. Replaces the nginx cache rules.
# Rules are additive: a path matching several blocks gets every header.

# Content-hashed build output (Astro names files like name.CDGfc0hd.js),
# so a changed file always gets a new URL and can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Files copied from public/ keep a stable name, so they must stay
# revalidatable. One day is a compromise between nginx's old 1y and safety.
/avatar/*
  Cache-Control: public, max-age=86400
/screenshoot/*
  Cache-Control: public, max-age=86400
/static/*
  Cache-Control: public, max-age=86400
/data/*
  Cache-Control: public, max-age=3600
/resume/*
  Cache-Control: public, max-age=3600
/favicon*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
/twitter-card.png
  Cache-Control: public, max-age=86400

# Keep every *.pages.dev host (production alias, branch previews, deploy
# hashes) out of search results. The custom domain is not matched here.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
